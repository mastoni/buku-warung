# Production Environment Variables for Buku Warung License Server
# Place in /var/www/bukuwarung-license/.env (chmod 600)

NODE_ENV=production
HOST=127.0.0.1
PORT=3100

# Persistent Isolated SQLite Database Location
DATABASE_PATH=/var/data/bukuwarung-license/license.db

# Production Secrets (Must be 32+ char random strings)
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=REPLACE_WITH_STRONG_PRODUCTION_ADMIN_API_KEY
SERVER_PEPPER=REPLACE_WITH_STRONG_PRODUCTION_SERVER_PEPPER

# Rate Limiting
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

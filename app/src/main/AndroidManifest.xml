<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Bluetooth Thermal Printer Permissions -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <!-- USB OTG Thermal Printer Feature -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Buku Warung"
        android:supportsRtl="true"
        android:theme="@style/Theme.BukuWarung">
        <!--
            Step 16: the app keeps its whole UI in composition-scoped `remember` state, and the
            app root (`BukuWarungApp`) holds its own gate state - `isDebugBypassed`,
            `isCheckingExistingUser` and the `LicenseManager` instance. The manifest previously
            declared no `configChanges`, so Android destroyed and rebuilt the entire composition on
            every rotation. That reset the gate state, re-ran the licence and tenant gates from
            scratch and dropped the merchant back onto the Licence Gate, which looks exactly like
            the app exiting. There was never a crash: the process survived every rotation.

            Declaring these two makes rotation a configuration change the Activity handles itself
            instead of being recreated for, so the current screen, any open dialog and the gate
            state all survive.

              * `orientation` - the change that was reported.
              * `screenSize`   - the mandatory companion. Since API 13 a rotation is reported as a
                                  screen size swap (width/height exchange), not only as an
                                  orientation change; without this flag Android still recreates the
                                  Activity on rotation.

            Deliberately NOT listed: uiMode, fontScale, locale, layoutDirection, density,
            screenLayout and smallestScreenSize. Those are separate configuration changes with
            separate risks, and the reported defect is orientation only.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
